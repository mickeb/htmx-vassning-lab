{% comment %}
  `error` marks the text field when a todo was submitted with no description.
  There is deliberately no message -- the red border is the whole report.
{% endcomment %}
<form class="new-todo" id="new-todo-form" method="post" action="/todo-app/todos">
  <input type="hidden" name="q" value="{{ q }}">
  <input type="hidden" name="sort" value="{{ sort }}">

  <input class="new-todo__input{% if error %} new-todo__input--error{% endif %}"
         type="text" name="description" placeholder="What needs doing?"
         {% if error %}aria-invalid="true" {% endif %}autocomplete="off">

  <button class="button" type="submit">Add</button>
</form>
