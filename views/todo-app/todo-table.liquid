{% comment %}
  The whole list: sortable header, one row per todo, and the message shown when
  there are none. Needs only `todos`, `q` and `sort`, so it renders standalone.

  #todo-table is always present, even with nothing in the list, because it is
  what swaps target. The empty message is a plain sibling of the table -- app.css
  decides which of the two is visible, so no server round trip is involved.
{% endcomment %}
<div class="todo-table" id="todo-table">
  <table class="todo-table__table">
    <thead>
      <tr>
        {% comment %}
          The whole column label is the sort control, and it toggles: the link
          always points at the opposite of the current order. The chevron shows
          which way the list is sorted right now.
        {% endcomment %}
        {% if sort == 'desc' %}{% assign next_sort = 'asc' %}{% else %}{% assign next_sort = 'desc' %}{% endif %}
        <th class="todo-table__col--created" scope="col" aria-sort="{% if sort == 'desc' %}descending{% else %}ascending{% endif %}">
          <a class="sort sort--{{ sort }}" href="/todo-app?sort={{ next_sort }}{% if q != "" %}&amp;q={{ q | url_encode }}{% endif %}">
            Created at
            <svg class="sort__chevron" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4"/></svg>
            <span class="visually-hidden">sorted {% if sort == 'desc' %}newest{% else %}oldest{% endif %} first; activate to reverse</span>
          </a>
        </th>
        <th scope="col">Description</th>
        <th class="todo-table__col--complete" scope="col">Complete</th>
      </tr>
    </thead>

    <tbody id="todo-rows">
      {% for todo in todos %}{% render 'todo-app/todo-row', todo: todo, q: q, sort: sort %}{% endfor %}
    </tbody>
  </table>

  <p class="todo-empty">No todos to show.</p>
</div>
