{% comment %}
  The whole list: sortable header, one row per todo, and the message shown when
  there are none. Needs only `todos`, `q` and `sort`, so it renders standalone.

  #todo-table and #todo-rows are always present, even with nothing in the list.
  The empty message is a plain sibling of the table -- app.css decides which of
  the two is visible, so no server round trip is involved.
{% endcomment %}
<div class="todo-table" id="todo-table">
  <table class="todo-table__table">
    <thead>
      <tr>
        <th class="todo-table__col--created" scope="col">
          Created at
          <span class="sort">
            <a class="sort__chevron{% if sort == 'asc' %} sort__chevron--active{% endif %}" href="/todo-app?sort=asc{% if q != "" %}&amp;q={{ q | url_encode }}{% endif %}" aria-label="Sort by created, oldest first"><svg viewBox="0 0 10 6" aria-hidden="true"><path d="M1 5l4-4 4 4"/></svg></a>
            <a class="sort__chevron{% if sort == 'desc' %} sort__chevron--active{% endif %}" href="/todo-app?sort=desc{% if q != "" %}&amp;q={{ q | url_encode }}{% endif %}" aria-label="Sort by created, newest first"><svg viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4"/></svg></a>
          </span>
        </th>
        <th scope="col">Description</th>
        <th class="todo-table__col--complete" scope="col">Complete</th>
      </tr>
    </thead>

    <tbody id="todo-rows">
      {% for todo in todos %}{% render 'todo-app/todo-row', todo: todo, q: q, sort: sort %}{% endfor %}
    </tbody>
  </table>

  <p class="todo-empty">No todos to show.</p>
</div>
